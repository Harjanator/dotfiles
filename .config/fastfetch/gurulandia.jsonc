{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "source": "~/.config/fastfetch/gl.txt",
      "type": "file"
    },
    "display": {
        "size": {
            "maxPrefix": "MB",
            "ndigits": 0,
            "spaceBeforeUnit": "never"
        },
        "freq": {
            "ndigits": 3,
            "spaceBeforeUnit": "never"
        }
    },
    "modules": [
        "break",
        "title",
        "separator",
        {  
            "type": "os",
            "format": "{pretty-name}",
        },
//        "os",
        {
            "type": "kernel",
            "format": "{release}"
        },
        "uptime",
//        {
//            "type": "packages",
//            "combined": true
//        },
        "break",
        "shell",
        {
            "type": "de",
            "key": "DE"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        "wmtheme",
        "theme",
        "icons",
        {
            "type": "editor",
            "format": "{name} {version}",
        },
        "terminal",
        {
            "type": "terminalfont",
            "format": "{/name}{-}{/}{name}{?size} {size}{?}"
        },
        "break",
//        {
//            "type": "cpu",
//            "showPeCoreCount": false
//        },
//        {
//            "type": "gpu",
//            "key": "GPU",
//            "format": "{name}"
//        },
        {
            "type": "memory",
            "format": "{used} / {total} ({percentage})"
        },
	"disk",
        "break",
        "localip",
	"publicip",
        "break",
	"dns",
        "break",
//        "colors"
    ]
}
